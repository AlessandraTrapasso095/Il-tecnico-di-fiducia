NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required in production: canonical public site URL used for redirects, checkout and email links
NEXT_PUBLIC_SITE_URL=

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_PROFESSION_SUGGESTION_PRICE_ID=


# Optional: enables Bearer-authenticated /api/stripe/reconcile calls from cron/external jobs
# Without it, reconcile remains available to authenticated admins
STRIPE_RECONCILE_SECRET=

# Required in production: salt for hashing rate-limit identifiers stored in DB
RATE_LIMIT_SALT=
GUEST_SUPPORT_TOKEN_SECRET=

# Optional/manual admin bootstrap reference values (do not expose in frontend)
INITIAL_ADMIN_EMAIL=admin@iltecnicodifiducia.it
INITIAL_ADMIN_TEMP_PASSWORD=

# Optional transactional SMTP used by app-side emails (support tickets, etc.).
# Supabase Auth emails still use Supabase SMTP settings.
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@iltecnicodifiducia.it
SMTP_PASS=
EMAIL_FROM="Il Tecnico di Fiducia <no-reply@iltecnicodifiducia.it>"
EMAIL_REPLY_TO=no-reply@iltecnicodifiducia.it
SUPPORT_ADMIN_EMAIL=admin@iltecnicodifiducia.it

# -------------------------------------------------------------------
# E2E authenticated tests — values belong only in .env.local / CI
# -------------------------------------------------------------------
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_PROFESSIONAL_EMAIL=
E2E_PROFESSIONAL_PASSWORD=
E2E_PROFESSIONAL_ID=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
